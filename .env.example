# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp?schema=public

# Web (Vite)
VITE_TENANT_ID=
VITE_USER_ID=
VITE_TENANT_SLUG=

# API
PORT=4000
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

# Seed: optional platform operator for /platform admin UI
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=

# Optional: ClickHouse analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=erp_analytics
