generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Core ———

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  timezone         String   @default("UTC")
  baseCurrencyCode String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users               User[]
  auditLogs           AuditLog[]
  warehouses          Warehouse[]
  products            Product[]
  stockBatches        StockBatch[]
  stockMovements      StockMovement[]
  sales               Sale[]
  departments         Department[]
  employees           Employee[]
  shifts              Shift[]
  attendanceRecords   AttendanceRecord[]
  leavePolicies       LeavePolicy[]
  leaveRequests       LeaveRequest[]
  payrollRuns         PayrollRun[]
  reorderRules        ReorderRule[]
  tenantSubscriptions TenantSubscription[]
}

// ——— SaaS billing & platform ops ———

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String?
  billingInterval BillingInterval?
  priceAmount     Decimal        @default(0) @db.Decimal(18, 4)
  currencyCode    String         @default("USD")
  isFreeTier      Boolean        @default(false)
  trialDays       Int            @default(0)
  features        Json
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions TenantSubscription[]

  @@index([isActive, sortOrder])
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  externalRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reminders SubscriptionReminder[]

  @@index([tenantId, status])
  @@index([currentPeriodEnd, status])
}

model SubscriptionReminder {
  id                       String             @id @default(uuid())
  tenantSubscriptionId     String
  tenantSubscription       TenantSubscription @relation(fields: [tenantSubscriptionId], references: [id], onDelete: Cascade)
  channel                  String             @default("EMAIL")
  templateKey              String             @default("RENEWAL_DUE")
  message                  String?
  metadata                 Json?
  createdByPlatformAdminId String?
  sentAt                   DateTime           @default(now())

  @@index([tenantSubscriptionId])
  @@index([sentAt])
}

model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  displayName  String
  passwordHash String
  role         String   @default("MEMBER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs                AuditLog[]
  stockMovementsPerformed  StockMovement[]
  salesAsCashier           Sale[]

  @@index([tenantId])
  @@unique([tenantId, email])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityName String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([tenantId, timestamp])
  @@index([tenantId, entityName, entityId])
}

model Currency {
  code         String   @id
  symbol       String
  exchangeRate Decimal  @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt
}

// ——— Inventory ———

enum StockValuationMethod {
  FIFO
  LIFO
}

enum StockMovementType {
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  WASTAGE
  SALE
  RETURN_IN
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  isVirtual   Boolean  @default(false)
  addressLine String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zones          WarehouseZone[]
  stockBatches   StockBatch[]
  movementsFrom  StockMovement[] @relation("MvFromWh")
  movementsTo    StockMovement[] @relation("MvToWh")
  reorderRules   ReorderRule[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseZone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  code        String
  isVirtual   Boolean   @default(false)
  sortOrder   Int       @default(0)
  rows        ZoneRow[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model ZoneRow {
  id        String        @id @default(uuid())
  zoneId    String
  zone      WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int           @default(0)
  shelves   RowShelf[]

  @@unique([zoneId, code])
  @@index([zoneId])
}

model RowShelf {
  id        String  @id @default(uuid())
  rowId     String
  row       ZoneRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  name      String
  code      String
  barcode   String?
  sortOrder Int     @default(0)

  @@unique([rowId, code])
  @@index([rowId])
}

model Product {
  id                   String               @id @default(uuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                  String
  name                 String
  description          String?
  unitOfMeasure        String               @default("EA")
  defaultValuation     StockValuationMethod @default(FIFO)
  barcode              String?
  qrPayload            String?
  isActive             Boolean              @default(true)
  reorderPointQuantity Decimal?             @db.Decimal(18, 4)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  batches      StockBatch[]
  saleLines    SaleLine[]
  reorderRules ReorderRule[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
}

model StockBatch {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lotNumber      String?
  serialNumbers  String[]  @default([])
  quantityOnHand Decimal   @db.Decimal(18, 4)
  receivedAt     DateTime  @default(now())
  expiresAt      DateTime?
  unitCostAmount Decimal   @db.Decimal(18, 4)
  currencyCode   String

  movements StockMovementLine[]

  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, expiresAt])
}

model StockMovement {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            StockMovementType
  reference       String?
  occurredAt      DateTime          @default(now())
  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("MvFromWh", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("MvToWh", fields: [toWarehouseId], references: [id])
  reason          String?
  performedById   String
  performedBy     User              @relation(fields: [performedById], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  lines StockMovementLine[]

  @@index([tenantId, type, occurredAt])
  @@index([tenantId, fromWarehouseId])
  @@index([tenantId, toWarehouseId])
}

model StockMovementLine {
  id             String        @id @default(uuid())
  movementId     String
  movement       StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  stockBatchId   String
  stockBatch     StockBatch    @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  quantityDelta  Decimal       @db.Decimal(18, 4)
  unitCostAmount Decimal       @db.Decimal(18, 4)
  currencyCode   String

  @@index([movementId])
  @@index([stockBatchId])
}

model ReorderRule {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  minimumQuantity Decimal   @db.Decimal(18, 4)
  reorderQuantity Decimal   @db.Decimal(18, 4)
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
}

// ——— POS ———

enum SaleStatus {
  OPEN
  COMPLETED
  VOID
}

model Sale {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber  String
  status         SaleStatus @default(COMPLETED)
  subtotalAmount Decimal    @db.Decimal(18, 4)
  taxAmount      Decimal    @db.Decimal(18, 4)
  totalAmount    Decimal    @db.Decimal(18, 4)
  currencyCode   String
  cashierUserId  String
  cashier        User       @relation(fields: [cashierUserId], references: [id], onDelete: Restrict)
  offlineQueueId String?
  createdAt      DateTime   @default(now())
  localizedAt    DateTime?

  lines    SaleLine[]
  payments SalePayment[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, createdAt])
}

model SaleLine {
  id             String  @id @default(uuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(18, 4)
  lineTotal      Decimal @db.Decimal(18, 4)
  taxRatePercent Decimal @db.Decimal(9, 4)
  currencyCode   String
  discountAmount Decimal @default(0) @db.Decimal(18, 4)

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  OTHER
}

model SalePayment {
  id           String        @id @default(uuid())
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method       PaymentMethod
  amount       Decimal       @db.Decimal(18, 4)
  currencyCode String
  reference    String?

  @@index([saleId])
}

// ——— HR ———

model Department {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

model Employee {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String
  email          String
  fullName       String
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id])
  jobTitle       String?
  hireDate       DateTime
  employmentType EmploymentType @default(FULL_TIME)
  baseSalary     Decimal        @db.Decimal(18, 4)
  salaryCurrency String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contracts         EmploymentContract[]
  attendance        AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  approvedLeaves    LeaveRequest[]     @relation("LeaveApprover")
  payslips          Payslip[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model EmploymentContract {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title             String
  storageKey        String
  contentType       String
  kmsKeyId          String?
  encryptionIv      String?
  encryptedByteSize Int
  uploadedAt        DateTime @default(now())

  @@index([employeeId])
}

model Shift {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  startUtc   DateTime
  endUtc     DateTime
  timezone   String
  attendance AttendanceRecord[]

  @@index([tenantId])
}

model AttendanceRecord {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId         String?
  shift           Shift?    @relation(fields: [shiftId], references: [id])
  clockInAt       DateTime
  clockOutAt      DateTime?
  clockInIp       String?
  clockOutIp      String?
  clockInLat      Decimal?  @db.Decimal(10, 7)
  clockInLng      Decimal?  @db.Decimal(10, 7)
  geofenceRadiusM Int?
  overtimeMinutes Int       @default(0)
  notes           String?

  @@index([tenantId, employeeId, clockInAt])
}

enum LeaveStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeavePolicy {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  accrualHoursPerMonth Decimal @db.Decimal(18, 4)
  maxCarryoverHours  Decimal  @db.Decimal(18, 4)
  approvalTier       Int      @default(1)
  createdAt          DateTime @default(now())

  requests LeaveRequest[]

  @@index([tenantId])
}

model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId     String
  policy       LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  startAt      DateTime
  endAt        DateTime
  hours        Decimal     @db.Decimal(18, 4)
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approver     Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt    DateTime?
  balanceAfter Decimal?    @db.Decimal(18, 4)
  currencyCode String      @default("HOURS")

  @@index([tenantId, status])
  @@index([employeeId])
}

model PayrollRun {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  runAt        DateTime @default(now())
  processedBy  String
  status       String   @default("COMPLETED")
  currencyCode String

  payslips Payslip[]

  @@index([tenantId, periodStart])
}

model Payslip {
  id            String     @id @default(uuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  grossPay      Decimal    @db.Decimal(18, 4)
  bonusPay      Decimal    @db.Decimal(18, 4)
  taxDeduction  Decimal    @db.Decimal(18, 4)
  insuranceAmt  Decimal    @db.Decimal(18, 4)
  netPay        Decimal    @db.Decimal(18, 4)
  currencyCode  String
  pdfStorageKey String?
  pdfSha256     String?
  issuedAt      DateTime   @default(now())

  components PayslipComponent[]

  @@index([payrollRunId])
  @@index([employeeId])
}

model PayslipComponent {
  id           String  @id @default(uuid())
  payslipId    String
  payslip      Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code         String
  label        String
  amount       Decimal @db.Decimal(18, 4)
  currencyCode String

  @@index([payslipId])
}
