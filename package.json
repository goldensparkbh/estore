{
  "name": "erp-platform",
  "private": true,
  "workspaces": ["apps/*"],
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @erp/api\" \"npm run dev -w @erp/web\"",
    "dev:web": "npm run dev -w @erp/web",
    "dev:api": "npm run dev -w @erp/api",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "postinstall": "npm run db:generate",
    "db:generate": "npx prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "npm -w @erp/api exec prisma migrate dev",
    "db:push": "npm -w @erp/api exec prisma db push",
    "db:seed": "npm -w @erp/api exec prisma db seed",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
